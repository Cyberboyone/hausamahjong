<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFC107"
                android:centerColor="#FFB300"
                android:endColor="#FF8F00"
                android:angle="270" />
            <corners android:radius="28dp" />
            <stroke
                android:width="2dp"
                android:color="#FFA000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFE082"
                android:centerColor="#FFD54F"
                android:endColor="#FFA000"
                android:angle="270" />
            <corners android:radius="28dp" />
            <stroke
                android:width="2dp"
                android:color="#FFB300" />
        </shape>
    </item>
</selector>
