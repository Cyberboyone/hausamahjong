<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D3B3B"
                android:centerColor="#1A5C5C"
                android:endColor="#0D3B3B"
                android:angle="135" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20FFD54F"
                android:endColor="#00FFD54F"
                android:angle="45" />
        </shape>
    </item>
</layer-list>
