<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="180dp"
            android:layout_height="180dp"
                    android:src="@drawable/ic_splash_icon"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFD54F"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Karin Magana"
            android:textSize="16sp"
            android:textColor="#80CBC4"
            android:letterSpacing="0.15"
            android:layout_marginBottom="60dp" />

        <LinearLayout
            android:id="@+id/proverbSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvProverb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="italic"
                android:textColor="#FFD54F"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProverbMeaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#80CBC4"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="40dp" />

            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp">

                <View
                    android:id="@+id/loadingBarBg"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_loading_bar" />

                <View
                    android:id="@+id/loadingBar"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"
                    android:background="#FFFFFF" />

                <ImageView
                    android:id="@+id/ivLoadingTile"
                    android:layout_width="28dp"
                    android:layout_height="35dp"
            android:src="@drawable/ic_splash_icon"
                    android:scaleType="fitCenter"
                    android:layout_gravity="center_vertical" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="12sp"
                android:textColor="#80CBC4"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="2" />
    </LinearLayout>

</FrameLayout>
