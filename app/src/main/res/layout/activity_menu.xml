<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal|center_vertical"
        android:padding="24dp">

        <!-- Top Bar: Coin Counter -->
        <LinearLayout
            android:id="@+id/coinContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₦0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFD54F"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:padding="8dp"
                android:background="@drawable/bg_coin_counter"
                android:drawableStart="@drawable/ic_coin"
                android:drawablePadding="6dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            android:layout_marginBottom="12dp"
            android:elevation="8dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFD54F"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Karin Magana"
            android:textSize="15sp"
            android:textColor="#A5D6A7"
            android:letterSpacing="0.2"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCurrentLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFD54F"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:text="@string/play"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0D4F24"
            android:background="@drawable/bg_button_gold"
            android:layout_marginBottom="16dp"
            android:elevation="6dp" />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnShop"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_circle_green"
                android:src="@drawable/ic_coin"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:contentDescription="Shop"
                app:tint="#FFD54F"
                android:elevation="4dp"
                android:layout_marginEnd="12dp" />

            <ImageButton
                android:id="@+id/btnDailyReward"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_circle_green"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:contentDescription="Daily Reward"
                app:tint="#FFD54F"
                android:elevation="4dp"
                android:layout_marginEnd="12dp" />

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_circle_green"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:contentDescription="Profile"
                app:tint="#FFD54F"
                android:elevation="4dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_circle_green"
            android:src="@android:drawable/ic_menu_manage"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="@string/settings"
            app:tint="#FFFFFF"
            android:elevation="4dp"
            android:layout_marginBottom="8dp" />
    </LinearLayout>

</FrameLayout>