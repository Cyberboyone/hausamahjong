<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFD54F"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Karin Magana"
            android:textSize="18sp"
            android:textColor="#A5D6A7"
            android:layout_marginBottom="60dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:text="@string/play"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_wooden_button_large"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnLevelSelect"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="@string/level_select"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_wooden_button_rect"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="@string/settings"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_wooden_button_rect" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="2" />
    </LinearLayout>

</FrameLayout>
