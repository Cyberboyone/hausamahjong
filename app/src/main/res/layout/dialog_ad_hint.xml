<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_dialog_premium">

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/watch_ad_for_hint"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFD54F"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnWatch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/watch_ad_for_hint"
        android:textSize="14sp"
        android:textColor="#0D4F24"
        android:background="@drawable/bg_button_gold"
        android:layout_marginBottom="12dp"
        android:elevation="4dp" />

    <Button
        android:id="@+id/btnNoThanks"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/no_ads_thanks"
        android:textSize="14sp"
        android:textColor="#A5D6A7"
        android:background="@android:color/transparent"
        android:elevation="0dp" />

</LinearLayout>
