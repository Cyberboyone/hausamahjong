<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_root"
    android:orientation="vertical">

    <!-- Top HUD Bar -->
    <LinearLayout
        android:id="@+id/hudTop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_hud_slim"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp">

        <!-- Level Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level"
                android:textSize="10sp"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/sky_accent"
                android:letterSpacing="0.15"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvLevelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/soft_gold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- Moves -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/moves"
                android:textSize="10sp"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/sky_accent"
                android:letterSpacing="0.15"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvMoves"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/text_primary"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- Timer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time"
                android:textSize="10sp"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/sky_accent"
                android:letterSpacing="0.15"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/text_primary"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hints -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hints"
                android:textSize="10sp"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/sky_accent"
                android:letterSpacing="0.15"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvHints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/soft_gold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- Coins -->
        <LinearLayout
            android:id="@+id/coinContainer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_pill_icon"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_coin"
                android:layout_marginEnd="6dp"
                app:tint="@color/soft_gold" />

            <TextView
                android:id="@+id/tvCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₦500"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/soft_gold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>
    </LinearLayout>

    <!-- Game Board -->
    <com.nakudin.hausamahjong.ui.BoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/hudBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="12dp"
        android:gravity="center">

        <!-- Undo Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="12dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_button_pill_icon"
                    android:contentDescription="@string/undo"
                    android:src="@drawable/ic_undo"
                    android:scaleType="centerInside"
                    android:padding="14dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_press_scale" />

                <TextView
                    android:id="@+id/badgeUndoCount"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:gravity="center"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito_regular"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_badge_red"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/undo"
                android:textSize="11sp"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/sky_accent"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Hint Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="12dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageButton
                    android:id="@+id/btnHint"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_button_pill_icon"
                    android:contentDescription="@string/hint"
                    android:src="@drawable/ic_hint"
                    android:scaleType="centerInside"
                    android:padding="14dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_press_scale" />

                <TextView
                    android:id="@+id/badgeHints"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:gravity="center"
                    android:text="3"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito_regular"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_badge_red" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint"
                android:textSize="11sp"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/sky_accent"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Menu Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnMenuBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_pill_icon"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu_pause"
                android:scaleType="centerInside"
                android:padding="14dp"
                android:elevation="4dp"
                android:stateListAnimator="@animator/button_press_scale" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu"
                android:textSize="11sp"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/sky_accent"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
