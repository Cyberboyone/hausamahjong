<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20">

    <com.nakudin.hausamahjong.ui.BoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="80dp" />

    <LinearLayout
        android:id="@+id/hudTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#1B5E20"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/menu"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFD54F"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvMoves"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/moves"
                android:textSize="11sp"
                android:textColor="#A5D6A7"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvHints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textSize="14sp"
                android:textColor="#FFD54F"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hints"
                android:textSize="11sp"
                android:textColor="#A5D6A7"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3:00"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pause"
                android:textSize="11sp"
                android:textColor="#A5D6A7" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectedTile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:text=""
        android:textSize="13sp"
        android:textColor="#FFD54F"
        android:alpha="0.9" />

    <LinearLayout
        android:id="@+id/hudBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#1B5E20"
        android:elevation="8dp"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_wooden_button"
            android:contentDescription="@string/undo"
            android:src="@android:drawable/ic_menu_revert"
            android:scaleType="centerInside"
            android:padding="14dp"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnHint"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_wooden_button_large"
            android:contentDescription="@string/hint"
            android:src="@android:drawable/ic_menu_info_details"
            android:scaleType="centerInside"
            android:padding="16dp"
            app:tint="#FFD54F" />
    </LinearLayout>

</FrameLayout>
