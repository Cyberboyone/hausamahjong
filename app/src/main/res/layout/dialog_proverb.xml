<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_dialog_premium">

    <TextView
        android:id="@+id/tvProverbTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proverb_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFD54F"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvProverbHausa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="italic"
        android:textColor="#FFD54F"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvProverbEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#A5D6A7"
        android:gravity="center"
        android:fontFamily="sans-serif-light"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#A5D6A7"
        android:gravity="center"
        android:fontFamily="sans-serif-light"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnToggleEnglish"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:text="@string/show_english"
        android:textSize="14sp"
        android:textColor="#0D4F24"
        android:background="@drawable/bg_button_gold"
        android:layout_marginBottom="12dp"
        android:elevation="4dp" />

    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:text="@string/next_proverb"
        android:textSize="16sp"
        android:textColor="#0D4F24"
        android:background="@drawable/bg_button_gold"
        android:elevation="4dp" />

</LinearLayout>
