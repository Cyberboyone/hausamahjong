<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_dialog_lose">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lose"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/coral_pink"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't give up!"
        android:textSize="14sp"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/sky_accent"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="28dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:text="@string/menu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_regular"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_button_pill_green"
            android:layout_marginEnd="8dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/btnTryAgain"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:text="@string/try_again"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_regular"
            android:textColor="@color/text_dark"
            android:background="@drawable/bg_button_pill_gold"
            android:layout_marginStart="8dp"
            android:elevation="4dp" />
    </LinearLayout>

</LinearLayout>
