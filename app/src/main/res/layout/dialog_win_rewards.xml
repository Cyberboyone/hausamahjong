<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_purple">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/win"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/soft_gold"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvLevelSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/sky_accent"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/rowMoves"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvMoves"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/soft_gold"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moves"
                        android:textSize="11sp"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/sky_accent"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowScore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/text_primary"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Score"
                        android:textSize="11sp"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/sky_accent"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/sky_accent"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textSize="11sp"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/sky_accent"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dialog_border"
                android:layout_marginBottom="14dp" />

            <!-- Rewards Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REWARDS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/soft_gold"
                android:letterSpacing="0.2"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <!-- Reward Rows -->
            <LinearLayout
                android:id="@+id/rewardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/rowBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_reward_row"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Base Clear"
                            android:textSize="14sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/level"
                            android:textSize="10sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/sky_accent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBaseReward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+₦50"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/soft_gold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowCombo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_reward_row"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Combo Bonus"
                            android:textSize="14sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick matches"
                            android:textSize="10sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/sky_accent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvComboReward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+₦0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/soft_gold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowNoHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_reward_row"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Hints Used"
                            android:textSize="14sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pure skill"
                            android:textSize="10sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/sky_accent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNoHintReward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+₦0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/soft_gold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowNoUndo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_reward_row"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Undo Used"
                            android:textSize="14sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="True mastery"
                            android:textSize="10sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/sky_accent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNoUndoReward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+₦0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/soft_gold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_reward_row"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Speed Bonus"
                            android:textSize="14sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Under 2 minutes"
                            android:textSize="10sp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/sky_accent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSpeedReward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+₦0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/soft_gold" />
                </LinearLayout>

                <!-- Total Row -->
                <LinearLayout
                    android:id="@+id/rowTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_reward_total"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:id="@+id/tvTotalReward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="₦50"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/text_dark" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/menu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_regular"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_button_pill_green"
            android:layout_marginEnd="8dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/next_level"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_regular"
            android:textColor="@color/text_dark"
            android:background="@drawable/bg_button_pill_gold"
            android:layout_marginStart="8dp"
            android:elevation="4dp" />
    </LinearLayout>

</LinearLayout>
