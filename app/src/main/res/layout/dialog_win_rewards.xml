<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_premium">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/win"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFD54F"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvLevelSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#A5D6A7"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/rowMoves"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvMoves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFD54F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moves"
                    android:textSize="11sp"
                    android:textColor="#A5D6A7" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score"
                    android:textSize="11sp"
                    android:textColor="#A5D6A7" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#A5D6A7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textSize="11sp"
                    android:textColor="#A5D6A7" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E8B57"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REWARDS"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFD54F"
            android:letterSpacing="0.15"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/rewardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/rowBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_reward_row"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Base Clear"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/level"
                    android:textSize="10sp"
                    android:textColor="#A5D6A7" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBaseReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₦50"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFD54F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCombo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_reward_row"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Combo Bonus"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick matches"
                    android:textSize="10sp"
                    android:textColor="#A5D6A7" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvComboReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₦0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFD54F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowNoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_reward_row"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Hints Used"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pure skill"
                    android:textSize="10sp"
                    android:textColor="#A5D6A7" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoHintReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₦0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFD54F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowNoUndo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_reward_row"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Undo Used"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="True mastery"
                    android:textSize="10sp"
                    android:textColor="#A5D6A7" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoUndoReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₦0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFD54F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_reward_row"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed Bonus"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Under 2 minutes"
                    android:textSize="10sp"
                    android:textColor="#A5D6A7" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSpeedReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₦0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFD54F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_reward_total"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFD54F" />

            <TextView
                android:id="@+id/tvTotalReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="₦50"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFD54F" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/menu"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green"
            android:layout_marginEnd="8dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/next_level"
            android:textSize="14sp"
            android:textColor="#0D4F24"
            android:background="@drawable/bg_button_gold"
            android:layout_marginStart="8dp"
            android:elevation="4dp" />
    </LinearLayout>

</LinearLayout>