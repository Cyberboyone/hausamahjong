<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_dialog_purple">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pause"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/soft_gold"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <!-- Toggle Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnSoundToggle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textSize="13sp"
            android:fontFamily="@font/nunito_regular"
            android:textColor="@color/sky_accent"
            android:background="@drawable/bg_button_small_green"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnVibrationToggle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:fontFamily="@font/nunito_regular"
            android:textColor="@color/sky_accent"
            android:background="@drawable/bg_button_small_green"
            android:elevation="2dp" />
    </LinearLayout>

    <!-- Resume Button -->
    <Button
        android:id="@+id/btnResume"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/resume"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/text_dark"
        android:background="@drawable/bg_button_pill_gold"
        android:layout_marginBottom="12dp"
        android:elevation="6dp" />

    <!-- Restart Button -->
    <Button
        android:id="@+id/btnRestart"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/restart"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_button_pill_green"
        android:layout_marginBottom="12dp"
        android:elevation="4dp" />

    <!-- Menu Button -->
    <Button
        android:id="@+id/btnMenu"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/menu"
        android:textSize="14sp"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/sky_accent"
        android:background="@android:color/transparent"
        android:elevation="0dp" />

</LinearLayout>
